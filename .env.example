# Copia este archivo a ".env" y ajusta los valores a tu entorno.
# Nunca subas tu ".env" real a un repositorio (ya está en .gitignore).

# Conexión a PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=programmer_db
# Si no se define DB_USER, la aplicación usa el usuario de Windows actual.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Lista de usuarios de Windows autorizados a ejecutar la aplicación,
# separados por comas (sin espacios). Se compara en minúsculas.
ALLOWED_USERS=jdoe,asmith,operator1
